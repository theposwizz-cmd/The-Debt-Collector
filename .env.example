# Copy this file to .env and fill in your own values. Never commit .env.
# On Render, set these in the service's Environment tab instead.

# Required: Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Required: PayPal REST app credentials, SANDBOX app
# (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional: Claude model (default claude-opus-5-5)
ANTHROPIC_MODEL=

# Optional: where the SQLite database and uploaded receipt photos live.
# Default: ./data/debt-collector.db and ./data/uploads
DATABASE_PATH=
UPLOAD_DIR=

# Optional: AI requests allowed per visitor IP per minute (default 20)
AI_RATE_LIMIT_PER_MIN=

# Optional, local dev only: API port when running `npm run dev` (default 3001).
# In production the server listens on PORT (Render sets it).
API_PORT=
# Optional: seed the demo when the database is empty (default true; set false to start empty)
SEED_DEMO=
